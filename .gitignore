# ==============================================================================
# Validation Cases & Telemetry Data
# Keep verification scripts, analysis tools, plots, case dicts, and motion telemetry.
# Full 3D time step volume fields and processor decomposition dumps
# are excluded here.
# ==============================================================================
validation/baseline_drag/*
!validation/baseline_drag/*.py
!validation/baseline_drag/*.sh
validation/mesh_convergence/*
!validation/mesh_convergence/*.py
!validation/mesh_convergence/*.sh

# Exclude heavy intermediate meshing directories and generated cell-region maps
validation/thinDisk2mm/meshing/
validation/thinDisk2mm_tumbling/meshing/
cellToRegion
validation/thinDisk2mm/case/render/slowdown40.mp4
validation/temporal_convergence/**/polyMesh/
validation/temporal_convergence/**/[0-9]*/

# Ensure motion telemetry required for ASME V&V 20 and verification reproducibility is tracked
!validation/**/postProcessing/**/motion.dat


# ==============================================================================
# OpenFOAM Build & Compilation Artifacts
# ==============================================================================
**/Make/linux*
lnInclude/
platforms/
linux64GccDPInt32Opt/
*.o
*.so
*.dep


# ==============================================================================
# OpenFOAM Time Steps and Simulation Data
# ==============================================================================
[1-9]*/
0.*/
-[0-9]*/
tutorials/**/0/
!0.orig/


# ==============================================================================
# OpenFOAM Parallel Decomposition & Post-Processing
# ==============================================================================
processor*
postProcessing*/
!validation/thinDisk2mm*/case/postProcessing/
!validation/thinDisk2mm*/case/postProcessing/**/
!validation/thinDisk2mm*/case/postProcessing/**/motion.dat
!validation/temporal_convergence/**/postProcessing/
!validation/temporal_convergence/**/postProcessing/**/
!validation/temporal_convergence/**/postProcessing/**/motion.dat
!validation/uhlmann_sphere/**/postProcessing/
!validation/uhlmann_sphere/**/postProcessing/**/
validation/uhlmann_sphere/**/postProcessing/**/force*.dat
validation/uhlmann_sphere/**/postProcessing/**/moment*.dat
!validation/uhlmann_sphere/**/postProcessing/**/motion.dat
!validation/fernandes2007/**/postProcessing/
!validation/fernandes2007/**/postProcessing/**/
!validation/fernandes2007/**/postProcessing/**/motion.dat
dynamicCode/


# ==============================================================================
# Logs and Simulation Temporary Files
# ==============================================================================
log*
*.log
*.foam


