**/polyMesh/sets/
**/polyMesh/cellLevel
**/polyMesh/level0Edge
**/polyMesh/pointLevel
**/polyMesh/surfaceIndex

extendedFeatureEdgeMesh/
*.extendedFeatureEdgeMesh
*.eMesh

# Duplicate intermediate meshing STLs (canonical copies preserved in case triSurface/)
**/meshing/staticMesh/constant/triSurface/*.stl
**/meshing/rotatingMesh/constant/triSurface/*.stl
validation/uhlmann_sphere/gate_fixed_AMI/meshing/triSurface/

*.obj
*.vtk
*.vtp

VTK/
sets/
surfaces/
uniform/


